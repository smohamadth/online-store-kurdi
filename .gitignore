# Local CI database, rebuilt from scratch by `prisma migrate deploy`
# (DATABASE_URL in .env.ci). Never commit it.
apps/api/prisma/ci.db
apps/api/prisma/ci.db-journal
# NOTE: migrations/ must be COMMITTED. It was ignored here, so a fresh clone
# received no schema at all - `prisma migrate deploy` had nothing to apply and
# tables like Banner never existed, making the admin gallery unusable.

