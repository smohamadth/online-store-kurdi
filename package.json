{
  "name": "online-store",
  "version": "1.0.0",
  "description": "Full-featured e-commerce store with SEO optimization and ML-ready analytics",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,magenta --kill-others-on-fail \"npm run dev --workspace apps/api\" \"npm run dev --workspace apps/web\"",
    "dev:api": "cd apps/api && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "cd apps/api && npm run build",
    "build:web": "cd apps/web && npm run build",
    "start": "concurrently \"npm run start:api\" \"npm run start:web\"",
    "start:api": "cd apps/api && npm run start",
    "start:web": "cd apps/web && npm run start",
    "db:migrate": "cd apps/api && npm run db:migrate",
    "db:generate": "cd apps/api && npm run db:generate",
    "db:studio": "cd apps/api && npm run db:studio",
    "db:seed": "cd apps/api && npm run db:seed",
    "db:reset": "cd apps/api && npm run db:reset",
    "docker:up": "cd docker && docker-compose up -d",
    "docker:down": "cd docker && docker-compose down",
    "docker:logs": "cd docker && docker-compose logs -f",
    "setup": "npm install && npm run docker:up && npm run db:migrate && npm run db:seed",
    "theme:create": "node scripts/scaffold-theme.mjs",
    "theme:pack": "node scripts/theme-pack.mjs",
    "theme:validate": "node scripts/theme-pack.mjs",
    "plugin:pack": "node scripts/plugin-pack.mjs",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "lint": "npm run lint:api && npm run lint:web",
    "lint:api": "cd apps/api && npm run lint",
    "lint:web": "cd apps/web && npm run lint",
    "test": "npm run test:api && npm run test:web",
    "test:api": "cd apps/api && npm run test:unit && npm run test:integration",
    "test:api:unit": "cd apps/api && npm run test:unit",
    "test:api:integration": "cd apps/api && npm run test:integration",
    "test:web": "cd apps/web && npm run test:all",
    "test:web:lib": "cd apps/web && npm run test",
    "test:web:components": "cd apps/web && npm run test:components",
    "db:deploy": "cd apps/api && npm run db:deploy"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.6",
    "archiver": "^7.0.1",
    "concurrently": "^8.2.2",
    "happy-dom": "^20.11.6",
    "pdfkit": "^0.19.1",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "ecommerce",
    "online-store",
    "nextjs",
    "express",
    "postgresql",
    "redis",
    "seo",
    "ml-ready"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/noto-kufi-arabic": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/readex-pro": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0"
  }
}
