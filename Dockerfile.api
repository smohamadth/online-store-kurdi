# API image for the store-builder.
#
# Build context: the repository root (the workspaces share one lockfile,
# so the image must be built from the root, not from apps/api):
#
#   docker build -f Dockerfile.api -t store-api .
#
# The runtime entrypoint applies pending Prisma migrations before the
# server starts, so `docker compose up` on a client server converges the
# database to the schema this build was made from.
#
# The full (dev) node_modules from the build stage is carried over on
# purpose: prisma is a devDependency and the entrypoint needs the CLI at
# runtime to run `migrate deploy`. The store-builder installs onto
# client servers, and a working one-command install beats a smaller
# image.

FROM node:20-alpine AS build
WORKDIR /app
RUN apk add --no-cache libc6-compat openssl
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
RUN npm ci --no-audit --no-fund
COPY . .
# Generate BOTH Prisma clients at build time.
#
# The client is provider-specific, so an image built only for SQLite fails
# every query against Postgres with "the URL must start with the protocol
# file:". Generating at runtime instead would work, but `prisma generate`
# DOWNLOADS the query engine when it is not already cached - verified: with no
# cached engine it reaches for binaries.prisma.sh. Making container start-up
# depend on an outbound HTTPS call to a third party is a bad trade for a
# store that may be firewalled, air-gapped, or simply booting during an
# outage.
#
# So both are produced here, where the engines are already cached by npm ci,
# and copied into place by the entrypoint. The SQLite client is generated
# LAST so it lands in the default node_modules/.prisma location, preserving
# today's behaviour for file: deployments.
RUN cd apps/api \
 && npx prisma generate --schema prisma/schema.postgres.prisma \
 && cp -r ../../node_modules/.prisma /tmp/prisma-postgres \
 && npx prisma generate \
 && npm run build

# Stash the Postgres client alongside the SQLite one. The entrypoint swaps it
# in when DATABASE_URL is a postgres:// URL - a file copy, no network.
RUN mkdir -p /app/prisma-clients && cp -r /tmp/prisma-postgres /app/prisma-clients/postgres

FROM node:20-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app/apps/api
RUN apk add --no-cache libc6-compat openssl
# Everything the server needs: compiled dist, the prisma schema + CLI,
# and the node_modules tree with the GENERATED client inside.
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api ./
COPY --from=build /app/apps/web/package.json ./../web/package.json
COPY --from=build /app/package.json ./../package.json
# The bundled themes are baked in so the entrypoint can seed them into the
# shared themes volume (docker-compose.prod.yml mounts themes_data there).
# The web container gets its own copy at build time; the API container needs
# these files so a fresh volume still contains the platform themes.
COPY --from=build /app/apps/web/themes ./../web/themes
# The pre-generated PostgreSQL client. The entrypoint copies it over
# node_modules/.prisma when DATABASE_URL is a postgres:// URL, so switching
# provider is a local file copy rather than a network round-trip at boot.
COPY --from=build /app/prisma-clients/postgres ./prisma-clients/postgres
COPY --from=build /app/scripts/entrypoint-api.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh
EXPOSE 3001
ENTRYPOINT ["./entrypoint.sh"]
