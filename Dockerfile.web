# Web (Next.js) image for the store-builder.
#
# Build context: the repository root:
#
#   docker build -f Dockerfile.web \
#     --build-arg NEXT_PUBLIC_API_URL=http://localhost:3001/api \
#     -t store-web .
#
# NEXT_PUBLIC_* values are baked in at BUILD time (they are client-side
# constants), so build the image with the public API URL the browser
# will actually use.
#
# The runtime stage runs the Next.js standalone server: .next/standalone
# is a pruned, self-contained node tree; .next/static and public/ are
# copied alongside it (standalone does not bundle them).

FROM node:20-alpine AS build
WORKDIR /app
RUN apk add --no-cache libc6-compat openssl
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
RUN npm ci --no-audit --no-fund
COPY . .
ARG NEXT_PUBLIC_API_URL=http://localhost:3001/api
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN cd apps/web && npm run build

FROM node:20-alpine AS runtime
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
WORKDIR /app
# The standalone bundle keeps the workspace layout (apps/web/server.js).
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
