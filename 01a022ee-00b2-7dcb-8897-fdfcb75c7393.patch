+              textDecoration: 'none',
+              color: '#000',
+              fontSize: '14px',
+              fontWeight: 500,
+            }}>
+              <DirectionArrow kind="forward" /> View FAQ
+            </Link>
+          </div>
+        </div>
+
+        {/* Contact Form */}
+        <div>
+          <form onSubmit={handleSubmit} style={{
+            padding: '24px',
+            border: '1px solid #e5e5e5',
+            borderRadius: '8px',
+            backgroundColor: 'var(--card-bg, white)',
+          }}>
+            {error && (
+              <div style={{
+                padding: '12px',
+                backgroundColor: '#fef2f2',
+                border: '1px solid #fecaca',
+                borderRadius: '6px',
