+    const token = await tokenFor(admin);
+    const res = await request(app)
+      .get('/api/orders/00000000-0000-0000-0000-000000000000/receipt')
+      .set('Authorization', `Bearer ${token}`);
+    expect(res.status).toBe(404);
+  });
+});
