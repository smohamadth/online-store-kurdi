+    render(
+      <ErrorBoundary>
+        <Boom />
+      </ErrorBoundary>,
+    );
+    screen.getByRole('button', { name: /refresh page/i }).click();
+    expect(reloadSpy).toHaveBeenCalled();
+  });
+});
