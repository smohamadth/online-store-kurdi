# Copy this to apps/api/.env before starting the API:
#
#     cp .env.example apps/api/.env
#
# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The default setup is SQLite - no database server to install, the file is
# created for you by `npm run db:deploy`.
#
# This MUST match `provider` in apps/api/prisma/schema.prisma, which ships as
# "sqlite". A mismatch stops the API with:
#
#     Error validating datasource `db`: the URL must start with the
#     protocol `file:`   (Prisma P1012)
#
# That is a config mismatch, not a broken install - see the README, section 16 (Troubleshooting).
DATABASE_URL="file:./dev.db"

# To use PostgreSQL instead:
#   1. set provider = "postgresql" in apps/api/prisma/schema.prisma
#   2. swap the two lines below
#   3. re-run: cd apps/api && npx prisma migrate dev
# DATABASE_URL=postgresql://store_user:store_password@localhost:5432/store_db

# ---------------------------------------------------------------------------
# Optional services - the API degrades gracefully when these are absent
# ---------------------------------------------------------------------------
# Redis: caching only. Not running it just means no cache.
REDIS_URL=redis://localhost:6379

# MinIO: S3-compatible uploads. Without it, images are stored on local disk.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=store-files
MINIO_USE_SSL=false

# Search backend. Default 'postgres' = the built-in Prisma `contains` search
# (no extra infrastructure). Set to 'elasticsearch' to enable the optional
# Elasticsearch-backed search (Sorani-aware analyzer + fuzzy/relevance
# scoring). The index is kept in step on product create/update/delete; run
# POST /api/products/search/reindex to rebuild it. If Elasticsearch is
# unreachable the API logs a warning and falls back to the Postgres search,
# so this is safe to enable before the cluster is up.
SEARCH_PROVIDER=postgres
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_INDEX=products

# Email: with no SMTP server, messages are written to the log instead of sent.
# MailHog on port 1025 is an easy local option.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourstore.com

# Stripe (optional) - enables card payment at checkout.
# Leave both empty to keep the offline flow (cash on delivery / bank
# transfer, settled by staff). To enable: create a Stripe account, put
# a secret key (sk_live_... / sk_test_...) here, and add a webhook in
# the Stripe dashboard pointing at https://<your-api>/api/payments/webhooks/stripe
# with event "checkout.session.completed" (the webhook secret goes below).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sentry (optional) - error tracking. Leave empty to run without
# error tracking; the app behaves identically either way.
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Must be at least 32 characters or the API refuses to start. CHANGE THIS
# before deploying anywhere real - it signs every login token.
JWT_SECRET=your-super-secret-jwt-key-change-in-production-at-least-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

FRONTEND_URL=http://localhost:3000

PORT=3001
NODE_ENV=development
API_VERSION=v1

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf

# Card payments are not implemented yet - see KNOWN_GAPS.md section 1.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Theme storage. Where admin-created / admin-installed themes live as
# theme.json files. Defaults to the web app's themes dir (../web/themes
# relative to the API cwd) in development; the production compose mounts a
# themes_data volume here. Bundled platform themes carry a .bundled marker
# and are never overwritable or deletable.
# THEMES_DIR=../web/themes

# Plugin storage (file-based, no DB): packages/ + state/ under PLUGINS_DIR.
# Defaults to apps/api/plugins relative to the API cwd; the production
# compose mounts a plugins_data volume here. Installed plugins are data-only
# (signed webhooks); bundled code plugins live in the API repo.
# PLUGINS_DIR=plugins

BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Security switches - leave these false
# ---------------------------------------------------------------------------
# true publishes customer reviews without moderation.
REVIEWS_AUTO_APPROVE=false

# true lets ANY logged-in customer mark their own order as paid. Demo only.
PAYMENTS_ALLOW_MOCK=false

# true turns on the public /api/analytics/track endpoints, which store a
# row (IP address, user agent, session, product IDs, search text) per
# customer event for the in-store analytics dashboard and product
# recommendations. Off by default: with it unset the endpoints 404. The
# storefront's /privacy page describes the enabled behaviour.
ANALYTICS_TRACKING_ENABLED=false
