# Environment used by CI (.github/workflows/ci.yml) and by anyone who wants to
# run the test suites locally against a throwaway database.
#
# This file is COMMITTED on purpose. It contains no real secrets - every value
# is either a local-only default or a dummy that satisfies the Zod schema in
# src/config/environment.ts. Never put a production credential here.
#
# Usage:
#   cp apps/api/.env.ci apps/api/.env

# SQLite file, created from scratch by `prisma migrate deploy`.
DATABASE_URL="file:./ci.db"

# Redis is optional - the API logs a warning and carries on without it.
REDIS_URL=redis://localhost:6379

# Must be >= 32 chars to satisfy the schema. Dummy value, CI only.
JWT_SECRET=ci-only-not-a-real-secret-0123456789abcdef
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# MinIO is optional; the API degrades to local filesystem storage.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=ci-access
MINIO_SECRET_KEY=ci-secret
MINIO_BUCKET=store-files
MINIO_USE_SSL=false

# No SMTP server in CI - email.service.ts logs instead of sending.
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=ci@example.com

FRONTEND_URL=http://127.0.0.1:3000

PORT=3001
NODE_ENV=development
API_VERSION=v1

# Generous limits: the suites fire hundreds of requests in a few seconds and
# would otherwise trip the rate limiter and fail for the wrong reason.
#
# All THREE budgets must be raised. The limiter was split into read/write/auth
# (src/config/rateLimits.ts) and RATE_LIMIT_MAX now sizes only the WRITE
# budget, so setting it alone left AUTH on its default of 20 per 15 minutes.
# The browser-regression job runs a dozen verify-*.py scripts back to back,
# each logging in as admin from the same IP inside one window - so the later
# scripts got "Too many requests" and failed as "admin login failed", which
# looks like a broken login rather than a throttle.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100000
RATE_LIMIT_READ_MAX=1000000
RATE_LIMIT_AUTH_MAX=100000

MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif

LOG_LEVEL=error
LOG_FILE=logs/app.log

# Lower than the production 12: bcrypt at 12 rounds makes seeding and the
# dozens of logins these suites perform noticeably slow on CI runners.
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://127.0.0.1:3000

# Keep the secure defaults under test - these are the privilege-escalation
# guards that scripts/regression.sh asserts.
REVIEWS_AUTO_APPROVE=false
PAYMENTS_ALLOW_MOCK=false
