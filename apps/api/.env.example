# Server Configuration
NODE_ENV=development
PORT=3001
API_VERSION=v1

# Database
#
# The default setup is SQLite - no database server to install; the file is
# created for you by `npm run db:deploy`.
#
# This MUST match `provider` in prisma/schema.prisma, which ships as "sqlite".
# A mismatch stops the API with Prisma P1012:
#
#     Error validating datasource `db`: the URL must start with the
#     protocol `file:`
#
# See TROUBLESHOOTING.md if you hit that.
DATABASE_URL="file:./dev.db"

# To use PostgreSQL instead:
#   1. set provider = "postgresql" in prisma/schema.prisma
#   2. swap the two lines below
#   3. re-run: npx prisma migrate dev
# DATABASE_URL=postgresql://store_user:store_password@localhost:5432/store_db

# Redis
REDIS_URL=redis://localhost:6379

# Search backend: 'postgres' (default, no infra) or 'elasticsearch' (optional
# advanced search). Elasticsearch fails soft to Postgres if unreachable.
SEARCH_PROVIDER=postgres
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_INDEX=products

# JWT
# MUST be replaced before deploying. This placeholder is published in the
# repository, so a server still using it is signing tokens with a key anyone
# can read - an attacker can mint an admin token. It is long enough to pass
# the min(32) schema check, so length validation will NOT catch it; the API
# refuses to boot with NODE_ENV=production while this value is unchanged.
#   generate with:  openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Local debugging only. When 'true', POST /api/auth/forgot-password echoes the
# reset token in its JSON response so you don't have to open MailHog. That
# token grants account takeover for the address, so it is refused outright
# when NODE_ENV=production. Leave unset unless you are actively debugging.
# EXPOSE_RESET_TOKEN=false

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=store-files
MINIO_USE_SSL=false

# Email (MailHog for development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourstore.com

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf

# Stripe (for payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Security
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000
# Reviews
# false (default) = new customer reviews go to the admin moderation queue
# true = reviews are published immediately
REVIEWS_AUTO_APPROVE=false

# Mock payment settlement. Leave false unless you are demoing locally:
# when true, ANY logged-in customer can mark their own order as paid.
PAYMENTS_ALLOW_MOCK=false

# Abandoned-cart recovery scheduler.
#
# OFF by default. Turning this on makes the API email customers unattended, so
# it needs a working SMTP config and a newsletter list with real consent
# first. Only the exact string 'on' enables it.
#   ABANDONED_CART_SCHEDULER=on
#
# Strongly recommended for the first run on a live store: report what WOULD be
# sent without emailing anyone. Only the exact string 'true' enables it.
#   ABANDONED_CART_DRY_RUN=true

# Analytics data retention.
#
# UserEvent rows hold per-customer behavioural data (session, user agent,
# truncated IP). Purging is ON by default because keeping personal data
# indefinitely is the unsafe state - set 'off' only if retention is managed
# externally (a DBA job, a warehouse export).
#   ANALYTICS_RETENTION=off
#
# Days of history to keep. Clamped to 7..3650; anything invalid falls back to
# the 180-day default rather than deleting more than intended.
#   ANALYTICS_RETENTION_DAYS=180
#
# Report what WOULD be deleted without deleting it. Worth one run before
# trusting a new window against real data.
#   ANALYTICS_RETENTION_DRY_RUN=true
