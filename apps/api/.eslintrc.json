{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended"],
  "env": {
    "node": true,
    "es2022": true
  },
  "ignorePatterns": ["dist/", "node_modules/", "prisma/"],
  "rules": {
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }
    ],
    "@typescript-eslint/no-empty-function": "off",
    "no-empty": ["error", { "allowEmptyCatch": true }],

    "@typescript-eslint/no-namespace": "off",
    "@typescript-eslint/no-var-requires": "off",

    // Deliberate: the email and rich-text sanitisers match raw control
    // characters (\x00-\x1f) precisely because header/markup injection relies
    // on them. Flagging that is a false positive here.
    "no-control-regex": "off",

    // Stylistic only — downgraded so `npm run lint` reports real problems
    // instead of failing the build on pre-existing formatting noise.
    "no-useless-escape": "warn",
    "no-extra-boolean-cast": "warn",
    "no-case-declarations": "warn",
    "prefer-const": "warn",
    "no-var": "warn"
  }
}
