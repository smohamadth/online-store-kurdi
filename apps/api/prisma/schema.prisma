// Prisma Schema for E-commerce Store (SQLite version for development)
// Use this schema when PostgreSQL is not available

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Read from the environment so the database can be pointed elsewhere
  // without editing this file. It was hardcoded to "file:./dev.db", which
  // silently ignored DATABASE_URL - .env.example advertises a PostgreSQL URL
  // that would never have been used.
  // To move to PostgreSQL: change provider to "postgresql", set DATABASE_URL,
  // then re-run `prisma migrate dev` to regenerate the migrations for PG.
  url      = env("DATABASE_URL")
}

// User model
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  role          String    @default("customer") // customer, admin, manager
  isActive      Boolean   @default(true)
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlist      WishlistItem[]
  cart          CartItem[]
  events        UserEvent[]
  preferences   UserPreference?
  sessions      Session[]
  passwordResets PasswordReset[]
  inventoryLogs InventoryLog[]
  stockTakes      StockTake[]
  reorderDrafts   ReorderDraft[]
  storeCredit     StoreCredit?
  giftCardsIssued  GiftCard[]   @relation("GiftCardCreatedBy")

  @@index([email])
  @@index([role])
  @@index([isActive])
}

// User session model
model Session {
  id            String    @id @default(uuid())
  userId        String
  refreshToken  String    @unique
  userAgent     String?
  ipAddress     String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([refreshToken])
}

// Password reset tokens
model PasswordReset {
  id            String    @id @default(uuid())
  userId        String
  token         String    @unique
  expiresAt     DateTime
  used          Boolean   @default(false)
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// User address model
model Address {
  id            String    @id @default(uuid())
  userId        String
  type          String    @default("shipping") // shipping, billing
  firstName     String
  lastName      String
  company       String?
  address1      String
  address2      String?
  city          String
  state         String
  postalCode    String
  country       String
  phone         String?
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]
  
  @@index([userId])
}

// Product category model
model Category {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  description   String?
  image         String?
  parentId      String?
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Self-relation for nested categories
  parent        Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryTree")
  
  // Relations
  products      Product[]
  
  @@index([slug])
  @@index([parentId])
  @@index([isActive])
}

// Product model
model Product {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  description   String
  shortDescription String?
  sku           String    @unique
  type          String    @default("physical") // physical, digital
  status        String    @default("draft") // draft, active, inactive, archived
  
  // Pricing
  price         Float
  compareAtPrice Float?
  costPrice     Float?
  
  // Inventory (for physical products)
  trackInventory Boolean   @default(true)
  quantity       Int       @default(0)
  lowStockThreshold Int    @default(10)
  // When true, the storefront lets a customer add to cart and check out
  // an out-of-stock product; the order ships when stock returns. The
  // checkout can still cap backorderable quantity if `backorderLimit` is set.
  allowBackorder Boolean   @default(false)
  backorderLimit Int?      // null = unlimited backorders when allowBackorder is true
  // "stock at zero" still allows search and PDP render, but hides
  // the "Add to cart" button unless allowBackorder is true.
  // Estimated restock date is shown on the PDP when set.
  expectedRestockAt DateTime?
  
  // Digital product fields
  downloadUrl   String?
  downloadLimit Int?
  downloadExpiry Int?     // days
  
  // Product details
  weight        Float?
  weightUnit    String?   @default("kg")
  dimensions    String?   // JSON string
  
  // SEO fields
  metaTitle     String?
  metaDescription String?
  metaKeywords  String    @default("[]") // JSON array
  
  // Relations
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id])
  taxClassId    String?
  taxClass      TaxClass? @relation(fields: [taxClassId], references: [id])
  images        ProductImage[]
  variants      ProductVariant[]
  reviews       Review[]
  wishlist      WishlistItem[]
  cart          CartItem[]
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]
  stockAlerts   StockAlert[]
  warehouseStocks WarehouseStock[]
  channelStocks ChannelStock[]
  reorderRules   ReorderRule[]
  reorderDrafts   ReorderDraft[]
  stockTakeItems  StockTakeItem[]
  warehouseTransfers WarehouseTransfer[]
  threePLSyncEvents ThreePLSyncEvent[]
  
  // ML/Analytics relations
  events        UserEvent[]
  embeddings    ProductEmbedding[]
  similarities1 ProductSimilarity[] @relation("ProductSimilarity1")
  similarities2 ProductSimilarity[] @relation("ProductSimilarity2")
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  publishedAt   DateTime?
  
  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([status])
  @@index([type])
  @@index([price])
}

// Product image model
model ProductImage {
  id            String    @id @default(uuid())
  productId     String
  url           String
  alt           String?
  thumbnail     String?
  medium        String?
  large         String?
  zoom          String?
  sortOrder     Int       @default(0)
  isPrimary     Boolean   @default(false)
  createdAt     DateTime  @default(now())

  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([productId])
}

// Product variant model (for size, color, etc.)
model ProductVariant {
  id            String    @id @default(uuid())
  productId     String
  name          String
  sku           String    @unique
  price         Float
  quantity      Int       @default(0)
  attributes    String    @default("{}") // JSON string
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  cartItems     CartItem[]
  inventoryLogs InventoryLog[]
  warehouseStocks WarehouseStock[]
  stockReservations StockReservation[]

  @@index([productId])
  @@index([sku])
}

// Review model
model Review {
  id            String    @id @default(uuid())
  userId        String
  productId     String
  rating        Int       // 1-5
  title         String?
  comment       String?
  isVerified    Boolean   @default(false)
  isApproved    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@unique([userId, productId])
  @@index([productId])
  @@index([rating])
}

// Wishlist model
model WishlistItem {
  id            String    @id @default(uuid())
  userId        String
  productId     String
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@unique([userId, productId])
  @@index([userId])
}

// Cart model
model CartItem {
  id            String    @id @default(uuid())
  userId        String
  productId     String
  variantId     String?
  quantity      Int       @default(1)
  // When set, the stock for this line is *reserved* (not yet decremented)
  // until `reservedUntil`. A cron-style endpoint releases expired
  // reservations back to available stock. NULL means the cart row is
  // not actively holding stock.
  reservedUntil DateTime?
  // Snapshot of the variant's attributes at add-to-cart time.
  variantSnapshot String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  reservation   StockReservation?

  @@unique([userId, productId, variantId])
  @@index([userId])
  @@index([reservedUntil])
}

// Order model
model Order {
  id            String    @id @default(uuid())
  orderNumber   String    @unique
  userId        String
  status        String    @default("pending") // pending, processing, shipped, delivered, cancelled, refunded
  
  // Pricing
  subtotal      Float
  taxAmount     Float     @default(0)
  shippingAmount Float    @default(0)
  discountAmount Float    @default(0)
  totalAmount   Float
  
  // Shipping
  shippingAddressId String?
  shippingMethodId  String?
  shippingZoneId    String?
  trackingNumber    String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  
  // Payment
  paymentMethod     String?
  paymentStatus     String    @default("pending") // pending, completed, failed, refunded
  paymentIntentId   String?   // Stripe payment intent ID
  
  // Notes
  notes             String?
  adminNotes        String?
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  cancelledAt       DateTime?
  
  // Relations
  user              User      @relation(fields: [userId], references: [id])
  shippingAddress   Address?  @relation(fields: [shippingAddressId], references: [id])
  shippingMethod    ShippingMethod? @relation(fields: [shippingMethodId], references: [id])
  items             OrderItem[]
  payments          Payment[]
  inventoryLogs     InventoryLog[]
  stockReservations StockReservation[]
  reorderDrafts     ReorderDraft[]
  
  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

// Order item model
model OrderItem {
  id            String    @id @default(uuid())
  orderId       String
  productId     String
  variantId     String?
  quantity      Int
  unitPrice     Float
  totalPrice    Float
  
  // Digital product fields
  downloadUrl   String?
  downloadCount Int       @default(0)
  downloadLimit Int?
  downloadExpiry DateTime?

  // Flag set at order-placement when the order line was created
  // against zero stock and the product allows backorders. Used by
  // warehouse reports to split backorders from normal sales.
  isBackorder   Boolean   @default(false)
  
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  
  @@index([orderId])
  @@index([productId])
}

// Payment model
model Payment {
  id            String    @id @default(uuid())
  orderId       String
  amount        Float
  currency      String    @default("USD")
  method        String    // stripe, paypal, etc.
  status        String    @default("pending") // pending, completed, failed, refunded
  transactionId String?
  gatewayResponse String? // JSON string
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  order         Order     @relation(fields: [orderId], references: [id])
  
  @@index([orderId])
  @@index([transactionId])
}

// Coupon model
model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  type          String    // percentage, fixed, free_shipping
  value         Float
  minOrderAmount Float?
  maxDiscountAmount Float?
  usageLimit    Int?
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  startsAt      DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([code])
  @@index([isActive])
}

// Gift card model.
//
// Codes are customer-facing; we generate them server-side as
// upper-cased 16-character strings (XXXX-XXXX-XXXX-XXXX) so
// they're easy to read and copy-paste. The `balance` field is
// the remaining value - it starts equal to `initialAmount` and
// is debited on each use. Allowing the balance to go negative is
// blocked at the service layer; the constraint here is just
// `>= 0` so a bad code that somehow ends up with a negative
// balance is visible in the data.
//
// status values:
//   'active'    - issued, can be redeemed
//   'depleted'  - balance === 0, can't be used further
//   'expired'   - expiresAt passed, can't be used
//   'cancelled' - admin voided the card
//
// Note: the service layer also rejects redemption on expired
// cards even when status='active', to handle clock drift between
// the time of issue and the next recheck.
model GiftCard {
  id            String    @id @default(uuid())
  code          String    @unique
  initialAmount Float
  balance       Float     @default(0)
  currency      String    @default("USD")
  status        String    @default("active")
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime?
  redeemedByUserId String?
  redeemedAt    DateTime?
  notes         String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  transactions  GiftCardTransaction[]
  createdBy     User?     @relation("GiftCardCreatedBy", fields: [createdById], references: [id])

  @@index([code])
  @@index([status])
  @@index([expiresAt])
}

// Append-only ledger for gift-card activity. Every balance
// change is a row here; the live `balance` on the card is the
// running total. This mirrors the inventory-log pattern and
// makes audits easy.
model GiftCardTransaction {
  id            String    @id @default(uuid())
  giftCardId    String
  amount        Float     // positive = credit (issue/refund), negative = debit (use)
  type          String    // 'issue', 'use', 'expire', 'cancel', 'adjust'
  orderId       String?
  notes         String?
  createdById   String?
  createdAt     DateTime  @default(now())

  giftCard      GiftCard  @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@index([giftCardId])
  @@index([orderId])
}

// Store credit - a per-user balance issued at refund time or as
// a goodwill gesture. Simpler than gift cards: no codes, no
// expiration, just a running balance per user. The same
// append-only ledger pattern is used for the audit trail.
model StoreCredit {
  id            String    @id @default(uuid())
  userId        String
  balance       Float     @default(0)
  currency      String    @default("USD")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  StoreCreditTransaction[]

  @@unique([userId, currency])
  @@index([userId])
}

model StoreCreditTransaction {
  id            String    @id @default(uuid())
  storeCreditId String
  amount        Float     // positive = credit, negative = debit
  type          String    // 'refund', 'goodwill', 'order_use', 'adjust'
  orderId       String?
  notes         String?
  createdById   String?
  createdAt     DateTime  @default(now())

  storeCredit   StoreCredit @relation(fields: [storeCreditId], references: [id], onDelete: Cascade)

  @@index([storeCreditId])
  @@index([orderId])
}

// Analytics and ML Data Collection Models

// User behavior events for ML
model UserEvent {
  id            String    @id @default(uuid())
  userId        String?
  sessionId     String
  eventType     String    // view, click, add_to_cart, purchase, search, wishlist
  productId     String?
  categoryId    String?
  searchQuery   String?
  metadata      String    @default("{}") // JSON string
  timestamp     DateTime  @default(now())
  userAgent     String?
  ipAddress     String?

  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  product       Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([eventType])
  @@index([timestamp])
  @@index([productId])
  @@index([sessionId])
}

// Product embeddings for content-based filtering
model ProductEmbedding {
  id            String    @id @default(uuid())
  productId     String    @unique
  embedding     String    // JSON array of floats
  modelVersion  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// User preferences learned from behavior
model UserPreference {
  id                String    @id @default(uuid())
  userId            String    @unique
  categoryScores    String    @default("{}") // JSON object
  brandScores       String    @default("{}") // JSON object
  priceRange        String    @default("{}") // JSON object
  stylePreferences  String    @default("{}") // JSON object
  lastUpdated       DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Product similarity scores
model ProductSimilarity {
  id              String    @id @default(uuid())
  product1Id      String
  product2Id      String
  similarityScore Float     // 0-1 similarity score
  similarityType  String    // content, collaborative, hybrid
  lastCalculated  DateTime  @default(now())

  product1        Product   @relation("ProductSimilarity1", fields: [product1Id], references: [id], onDelete: Cascade)
  product2        Product   @relation("ProductSimilarity2", fields: [product2Id], references: [id], onDelete: Cascade)

  @@unique([product1Id, product2Id, similarityType])
  @@index([product1Id])
  @@index([product2Id])
}

// Recommendation logs for A/B testing
model RecommendationLog {
  id                  String    @id @default(uuid())
  userId              String?
  sessionId           String
  recommendationType  String    // collaborative, content-based, hybrid
  algorithmVersion    String
  products            String    // JSON array of product IDs
  context             String    @default("{}") // JSON object
  clicked             Boolean   @default(false)
  purchased           Boolean   @default(false)
  timestamp           DateTime  @default(now())

  @@index([userId])
  @@index([recommendationType])
  @@index([timestamp])
  @@index([sessionId])
}

// Search analytics
model SearchQuery {
  id            String    @id @default(uuid())
  userId        String?
  sessionId     String
  query         String
  resultsCount  Int
  clickedProductId String?
  timestamp     DateTime  @default(now())

  @@index([query])
  @@index([timestamp])
  @@index([userId])
}

// ============================================
// SETTINGS & CONFIGURATION
// ============================================

// Store settings (single row)
model StoreSettings {
  id                    String    @id @default("default")
  
  // Store Info
  storeName             String    @default("My Store")
  storeDescription      String?   
  storeEmail            String    @default("info@store.com")
  storePhone            String?   
  storeAddress          String?   
  storeCity             String?   
  storeState            String?   
  storeZipCode          String?   
  storeCountry          String    @default("US")
  
  // Currency
  currency              String    @default("USD")
  currencySymbol        String    @default("$")
  currencyPosition      String    @default("before")
  
  // Units
  weightUnit            String    @default("kg")
  dimensionUnit         String    @default("cm")
  
  // Date/Time
  timezone              String    @default("UTC")
  dateFormat            String    @default("MM/DD/YYYY")
  
  // Social Media
  facebookUrl           String?   
  instagramUrl          String?   
  twitterUrl            String?   
  youtubeUrl            String?   
  
  // SEO
  metaTitle             String?   
  metaDescription       String?   
  googleAnalyticsId     String?   
  googleTagManagerId    String?   
  
  // Maintenance
  maintenanceMode       Boolean   @default(false)
  maintenanceMessage    String?   
  
  // Legal
  privacyPolicyUrl      String?   
  termsOfServiceUrl     String?   
  returnPolicyUrl       String?   
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model EmailTemplate {
  id            String    @id @default(uuid())
  name          String    @unique
  subject       String    
  htmlContent   String    
  textContent   String?   
  variables     String    @default("[]")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============================================
// INVENTORY MANAGEMENT
// ============================================

model InventoryLog {
  id                String    @id @default(uuid())
  productId         String
  variantId         String?   
  quantityChange    Int       
  previousQuantity  Int       
  newQuantity       Int       
  reason            String    
  notes             String?   
  orderId           String?   
  createdBy         String?   
  createdAt         DateTime  @default(now())

  product           Product   @relation(fields: [productId], references: [id])
  variant           ProductVariant? @relation(fields: [variantId], references: [id])
  order             Order?    @relation(fields: [orderId], references: [id])
  creator           User?     @relation(fields: [createdBy], references: [id])
  
  @@index([productId])
  @@index([createdAt])
  @@index([reason])
}

model StockAlert {
  id                    String    @id @default(uuid())
  productId             String    @unique
  lowStockThreshold     Int       @default(10)
  outOfStockThreshold   Int       @default(0)
  notifyEmail           String?   
  isActive              Boolean   @default(true)
  lastAlertSent         DateTime? 
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  product               Product   @relation(fields: [productId], references: [id])
}

// ============================================
// INVENTORY EXTENSIONS
// ============================================
//
// Everything below extends the original InventoryLog / StockAlert pair
// to cover: per-warehouse stock, stock reservations (cart-time holds),
// cycle counts, auto-reorder rules, multi-channel stock, and the 3PL
// sync log. Each model is small and focused; the orchestrating logic
// lives in apps/api/src/modules/inventory/inventory.service.ts.

// A physical location where stock is held. A brand with one warehouse
// just has one row; multi-location retailers have many. Stock moves
// between warehouses via the `WarehouseTransfer` model.
model Warehouse {
  id            String    @id @default(uuid())
  name          String
  code          String    @unique     // e.g. "DAL-01", "BER-EU"
  addressLine1  String?
  addressLine2  String?
  city          String?
  region        String?   // state / province
  country       String?   // ISO-2 ("US", "DE")
  postalCode    String?
  isActive      Boolean   @default(true)
  isDefault     Boolean   @default(false)  // exactly one should be true; helper enforces
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stocks        WarehouseStock[]
  transfersFrom WarehouseTransfer[] @relation("TransferFrom")
  transfersTo   WarehouseTransfer[] @relation("TransferTo")
  takeItems     StockTakeItem[]
  reorderRules  ReorderRule[]
  reorderDrafts ReorderDraft[]

  @@index([code])
  @@index([isActive])
}

// Per-warehouse stock for a product or variant. The parent product's
// `quantity` is denormalised: a writer to WarehouseStock is responsible
// for updating the parent too (the inventory service does this in
// `applyDelta`).
model WarehouseStock {
  id            String    @id @default(uuid())
  warehouseId   String
  productId     String
  variantId     String?
  quantity      Int       @default(0)
  // Soft-reserved count (held by active carts or backorders) inside
  // this warehouse. Available = quantity - reserved.
  reserved      Int       @default(0)
  // Reorder point: when `quantity - reserved <= reorderPoint`, the
  // auto-reorder job (if configured) creates a draft PO.
  reorderPoint  Int       @default(0)
  updatedAt     DateTime  @updatedAt

  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([warehouseId, productId, variantId])
  @@index([warehouseId])
  @@index([productId])
  @@index([variantId])
}

// Movement of stock between warehouses. status="in_transit" is a
// soft hold on the source; "completed" credits the destination and
// debits the source; "cancelled" releases the hold.
model WarehouseTransfer {
  id            String    @id @default(uuid())
  fromWarehouseId String
  toWarehouseId   String
  productId     String
  variantId     String?
  quantity      Int
  status        String    @default("in_transit")  // in_transit | completed | cancelled
  notes         String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  cancelledAt   DateTime?

  fromWarehouse Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  product       Product   @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([status])
}

// A reservation tied to a CartItem (or an Order, in the case of a
// backorder). `releasedAt` is set when the reservation expires or the
// cart is abandoned. The inventory service reads `reservedUntil` to
// decide if a hold is still active.
model StockReservation {
  id            String    @id @default(uuid())
  cartItemId    String?   @unique
  productId     String
  variantId     String?
  warehouseId   String?   // null = any warehouse (default pool)
  quantity      Int
  // When the reservation lapses if not consumed.
  reservedUntil DateTime
  releasedAt    DateTime?
  // Why the reservation exists.
  reason        String    @default("cart_hold")  // cart_hold | backorder | manual
  // Origin id, polymorphic. For cart_hold: cartItemId. For backorder: orderId.
  originType    String?   // cart | order | manual
  originId      String?
  createdAt     DateTime  @default(now())

  cartItem      CartItem? @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@index([variantId])
  @@index([reservedUntil])
  @@index([releasedAt])
}

// A cycle count (a.k.a. stock-take) session. Many StockTakeItems
// are counted under one session, then applied atomically.
model StockTake {
  id            String    @id @default(uuid())
  warehouseId   String
  name          String
  status        String    @default("in_progress")  // in_progress | applied | cancelled
  notes         String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  appliedAt     DateTime?
  cancelledAt   DateTime?

  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  items         StockTakeItem[]

  @@index([warehouseId])
  @@index([status])
}

model StockTakeItem {
  id            String    @id @default(uuid())
  stockTakeId   String
  productId     String
  variantId     String?
  warehouseId   String
  expected      Int       // book quantity when the take started
  counted       Int       // what the staffer counted
  variance      Int       // counted - expected
  notes         String?

  stockTake     StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([stockTakeId])
}

// Auto-reorder rules. When a product's effective stock drops below
// `threshold`, the auto-reorder job (cron) creates a ReorderDraft
// (a stub PO). The draft must be approved by a manager before any
// real action is taken.
model ReorderRule {
  id            String    @id @default(uuid())
  productId     String
  variantId     String?
  warehouseId   String?
  threshold     Int       @default(10)
  reorderQty    Int       @default(50)
  supplierName  String?   // free-text for now; would be a Supplier model in v2
  supplierEmail String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  drafts        ReorderDraft[]

  @@index([productId])
  @@index([isActive])
}

model ReorderDraft {
  id            String    @id @default(uuid())
  ruleId        String?
  productId     String
  variantId     String?
  warehouseId   String?
  quantity      Int
  status        String    @default("draft")  // draft | sent | cancelled | received
  supplierName  String?
  notes         String?
  createdAt     DateTime  @default(now())
  sentAt        DateTime?
  cancelledAt   DateTime?
  receivedAt    DateTime?

  rule          ReorderRule? @relation(fields: [ruleId], references: [id])
  product       Product   @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([status])
  @@index([productId])
}

// Sales channel (e.g. own-store, Amazon, eBay). Each product can have
// per-channel stock: the same SKU can be "5 on website, 0 on Amazon".
model Channel {
  id            String    @id @default(uuid())
  name          String    @unique       // "own_store", "amazon_us", ...
  displayName   String
  type          String    @default("online")  // online | marketplace | retail
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stocks        ChannelStock[]
  syncEvents    ThreePLSyncEvent[]

  @@index([isActive])
}

model ChannelStock {
  id            String    @id @default(uuid())
  channelId     String
  productId     String
  variantId     String?
  quantity      Int       @default(0)
  updatedAt     DateTime  @updatedAt

  channel       Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([channelId, productId, variantId])
  @@index([channelId])
  @@index([productId])
}

// Audit log of every stock-changing event from a 3PL or marketplace
// sync. Useful for reconciling external orders against the local
// order list.
model ThreePLSyncEvent {
  id            String    @id @default(uuid())
  channelId     String
  provider      String    // "amazon", "ebay", "shipbob", ...
  externalSku   String
  internalProductId String?
  internalVariantId String?
  delta         Int       // signed
  reason        String?   // "order", "return", "manual_adjust", ...
  externalRef   String?   // e.g. the channel-side order id
  raw           String?   // JSON string of the incoming webhook
  receivedAt    DateTime  @default(now())

  channel       Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([provider])
  @@index([receivedAt])
}

// Webhook signature secret for a provider. Stored as a free-text
// value; rotated by writing a new row and marking the old inactive.
model WebhookSecret {
  id            String    @id @default(uuid())
  provider      String    @unique
  secret        String
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  rotatedAt     DateTime?

  @@index([provider])
}

// ============================================
// SHIPPING MANAGEMENT
// ============================================

model ShippingZone {
  id            String    @id @default(uuid())
  name          String    
  countries     String    @default("[]")
  states        String    @default("[]")
  zipCodes      String    @default("[]")
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  methods       ShippingMethod[]
}

model ShippingMethod {
  id                    String    @id @default(uuid())
  zoneId                String    
  name                  String    
  description           String?   
  type                  String    
  baseRate              Float     @default(0)
  
  weightUnitRate        Float?    
  minWeight             Float?    
  maxWeight             Float?    
  
  pricePercentage       Float?    
  minOrderAmount        Float?    
  maxOrderAmount        Float?    
  
  itemCountRate         Float?    
  
  freeShippingThreshold Float?    
  
  minDeliveryDays       Int       @default(1)
  maxDeliveryDays       Int       @default(7)
  
  isActive              Boolean   @default(true)
  sortOrder             Int       @default(0)
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  zone                  ShippingZone @relation(fields: [zoneId], references: [id])
  orders                Order[]
  
  @@index([zoneId])
}

// ============================================
// TAX CONFIGURATION
// ============================================

model TaxRate {
  id            String    @id @default(uuid())
  name          String    
  rate          Float     
  country       String    
  state         String?   
  city          String?   
  zipCode       String?   
  taxClass      String    @default("standard")
  priority      Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([country])
  @@index([state])
  @@index([taxClass])
}

model TaxClass {
  id            String    @id @default(uuid())
  name          String    @unique
  description   String?   
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products      Product[]
}

// ============================================
// MENU MANAGEMENT
// ============================================

model Menu {
  id            String    @id @default(uuid())
  name          String    @unique
  location      String    @default("header")  // header, footer, sidebar
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items         MenuItem[]
  
  @@index([location])
  @@index([isActive])
}

model MenuItem {
  id            String    @id @default(uuid())
  menuId        String
  parentId      String?
  label         String
  url           String
  icon          String?
  target        String    @default("_self")  // _self, _blank
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  menu          Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent        MenuItem? @relation("MenuTree", fields: [parentId], references: [id])
  children      MenuItem[] @relation("MenuTree")
  
  @@index([menuId])
  @@index([parentId])
  @@index([sortOrder])
}
model Banner {
  id            String    @id @default(uuid())
  title         String
  subtitle      String?
  description   String?
  image         String
  mobileImage   String?
  linkUrl       String?
  buttonText    String?
  secondaryText String?
  secondaryUrl  String?
  badge         String?
  textColor     String    @default("#ffffff")
  overlayColor  String    @default("rgba(0,0,0,0.35)")
  align         String    @default("left")   // left, center, right
  position      String    @default("hero")   // hero, promo, strip
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([position])
  @@index([isActive])
  @@index([sortOrder])
}

/// Visual theme controlled from Admin → Appearance.
/// A single row (id = "default"), mirroring StoreSettings.
model ThemeSettings {
  id                String   @id @default("default")

  // Brand colours
  primaryColor      String   @default("#111111")
  primaryTextColor  String   @default("#ffffff")
  accentColor       String   @default("#2563eb")
  bodyBg            String   @default("#ffffff")
  cardBg            String   @default("#ffffff")
  bodyText          String   @default("#111111")
  mutedText         String   @default("#666666")
  borderColor       String   @default("#e5e5e5")
  headerBg          String   @default("#ffffff")
  headerText        String   @default("#111111")
  footerBg          String   @default("#fafafa")
  footerText        String   @default("#111111")
  priceColor        String   @default("#111111")
  saleColor         String   @default("#dc2626")

  // Typography
  fontFamily        String   @default("system")
  baseFontSize      Int      @default(16)
  headingWeight     Int      @default(800)

  // Shape & spacing
  radius            Int      @default(8)
  buttonRadius      Int      @default(8)
  containerWidth    Int      @default(1200)
  cardShadow        String   @default("soft")   // none | soft | strong

  // Layout toggles
  productsPerRow    Int      @default(4)
  showTrustBar      Boolean  @default(true)
  showTestimonials  Boolean  @default(true)
  showStats         Boolean  @default(true)
  showNewsletter    Boolean  @default(true)
  showDealCountdown Boolean  @default(true)
  showCategories    Boolean  @default(true)
  showFeatured      Boolean  @default(true)
  showNewArrivals   Boolean  @default(true)

  // Announcement bar
  announcementText  String?
  announcementLink  String?
  announcementBg    String   @default("#111111")
  announcementText2 String   @default("#ffffff")
  showAnnouncement  Boolean  @default(false)

  // Escape hatch
  customCss         String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Home page builder
//
// Each row is one block on the storefront home page. Order, visibility and the
// copy inside the block are all admin-editable and stored here, so the home
// page is data-driven instead of hardcoded in HomeView.tsx.
//
// `config` is a JSON string (SQLite has no JSON column) holding the block's
// type-specific payload - e.g. the four trust-bar items, or the testimonial
// list. Unknown/invalid JSON falls back to the shipped defaults rather than
// breaking the page.
// ---------------------------------------------------------------------------
model HomeSection {
  id        String   @id @default(uuid())
  key       String   @unique          // stable identifier: trustBar, categories, ...
  type      String                     // which renderer draws it
  title     String?
  subtitle  String?
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  config    String?                    // JSON string, block-specific
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// ---------------------------------------------------------------------------
// Custom storefront pages (CMS)
//
// Pages like /privacy, /terms and /faq shipped as hardcoded .tsx files, so a
// shop owner could not change a word without editing source and redeploying.
// This model backs admin-authored pages served at /p/<slug>.
//
// `content` is sanitised HTML - see utils/sanitizeRichText.ts. It is rendered
// with dangerouslySetInnerHTML, so it MUST be cleaned on write, never on read.
// ---------------------------------------------------------------------------
model Page {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  content         String   @default("")
  excerpt         String?

  // draft pages are reachable only by an admin preview; published pages are
  // public and appear in the sitemap.
  status          String   @default("draft")   // draft | published

  // SEO. Empty values fall back to title/excerpt at render time.
  metaTitle       String?
  metaDescription String?

  // Show this page in the footer "Legal"/"Support" style lists.
  showInFooter    Boolean  @default(false)
  sortOrder       Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  publishedAt     DateTime?

  @@index([status])
  @@index([slug])
}

// ---------------------------------------------------------------------------
// Blog
//
// Deliberately a SEPARATE model from Page rather than a `type` column on it.
// A post carries things a static page never does - cover image, author,
// publish date, tags, reading time - and it is listed chronologically at
// /blog while pages are standalone at /p/<slug>. Overloading one table would
// mean half its columns are always null.
//
// `content` is sanitised HTML (utils/sanitizeRichText.ts). It is rendered with
// dangerouslySetInnerHTML, so it MUST be cleaned on write, never on read.
// ---------------------------------------------------------------------------
model BlogPost {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  content         String   @default("")
  excerpt         String?

  coverImage      String?

  // Free-text author name rather than a User relation: shops often publish
  // under a shop name or a staff member who has no login.
  author          String?

  // JSON string array, e.g. ["shipping","guides"]. SQLite has no array type;
  // parsed in one place (fromRow) so a corrupt value cannot break the page.
  tags            String?

  status          String   @default("draft")   // draft | published

  // Pinned posts sort to the top of /blog regardless of date.
  isFeatured      Boolean  @default(false)

  // SEO. Empty values fall back to title/excerpt at render time.
  metaTitle       String?
  metaDescription String?

  // Denormalised counter. Cheap to read on a list page; incrementing it is
  // fire-and-forget so a failure never blocks rendering the post.
  viewCount       Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  publishedAt     DateTime?

  @@index([status])
  @@index([slug])
  @@index([publishedAt])
}
