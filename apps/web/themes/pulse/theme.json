{
  "key": "pulse",
  "name": "Pulse",
  "niche": "DTC & apps",
  "description": "Rounded, current storefront for new brands and digital-native shops: indigo accent, pill CTAs, card canvas, dark footer.",
  "version": "1.3.1",
  "author": "Store Builder Platform",
  "preview": "/themes/pulse/preview.png",
  "features": {
    "rtl": true,
    "darkMode": false,
    "paid": false
  },
  "tokens": {
    "primaryColor": "#0f172a",
    "primaryTextColor": "#ffffff",
    "accentColor": "#4f46e5",
    "bodyBg": "#f8fafc",
    "cardBg": "#ffffff",
    "bodyText": "#0f172a",
    "mutedText": "#64748b",
    "borderColor": "#e2e8f0",
    "headerBg": "#ffffff",
    "headerText": "#0f172a",
    "footerBg": "#0f172a",
    "footerText": "#e2e8f0",
    "priceColor": "#0f172a",
    "saleColor": "#dc2626",
    "fontFamily": "system",
    "baseFontSize": 16,
    "headingWeight": 700,
    "radius": 16,
    "buttonRadius": 999,
    "containerWidth": 1280,
    "cardShadow": "soft",
    "productsPerRow": 3,
    "showTrustBar": true,
    "showTestimonials": true,
    "showStats": true,
    "showNewsletter": true,
    "showDealCountdown": true,
    "showCategories": true,
    "showFeatured": true,
    "showNewArrivals": true,
    "announcementBg": "#4f46e5",
    "announcementText2": "#ffffff"
  },
  "sections": {
    "hero": "@/themes/pulse/sections/Hero",
    "featured": "@/themes/pulse/sections/Featured",
    "categories": "@/themes/pulse/sections/Categories"
  },
  "layouts": {
    "home": {
      "columns": 12,
      "gap": 20,
      "blocks": [
        {
          "id": "hero",
          "type": "hero",
          "colStart": 1,
          "colSpan": 12,
          "rowStart": 1,
          "rowSpan": 1,
          "config": {
            "hero": {
              "layout": "slideshow",
              "height": "tall",
              "autoPlay": true,
              "intervalSec": 4,
              "arrows": true,
              "dots": true
            }
          }
        },
        {
          "id": "dealCountdown",
          "type": "dealCountdown",
          "colStart": 1,
          "colSpan": 12,
          "rowStart": 2,
          "rowSpan": 1,
          "config": {
            "title": "Today only",
            "subtitle": "Timer hits zero, price goes back.",
            "badge": "Flash",
            "buttonText": "Grab it",
            "buttonHref": "/deals"
          }
        },
        {
          "id": "featured",
          "type": "featured",
          "colStart": 1,
          "colSpan": 12,
          "rowStart": 3,
          "rowSpan": 1,
          "config": {
            "title": "Best sellers",
            "subtitle": "What just sold out last week.",
            "limit": 8
          }
        },
        {
          "id": "stats",
          "type": "stats",
          "colStart": 1,
          "colSpan": 12,
          "rowStart": 4,
          "rowSpan": 1,
          "config": {
            "items": [
              {
                "value": "2",
                "suffix": "h",
                "label": "Average delivery"
              },
              {
                "value": "50",
                "suffix": "k+",
                "label": "Subscribers"
              },
              {
                "value": "4.8",
                "suffix": "/5",
                "label": "Rating"
              }
            ]
          }
        },
        {
          "id": "cta",
          "type": "cta",
          "colStart": 1,
          "colSpan": 12,
          "rowStart": 5,
          "rowSpan": 1,
          "config": {
            "title": "Join the list",
            "subtitle": "Drops go to email first.",
            "buttonText": "Shop now",
            "buttonHref": "/products"
          }
        },
        {
          "id": "newsletter",
          "type": "newsletter",
          "colStart": 1,
          "colSpan": 12,
          "rowStart": 6,
          "rowSpan": 1,
          "config": {
            "title": "Get the next drop"
          }
        }
      ]
    }
  }
}
