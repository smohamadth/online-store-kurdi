{
  "key": "pulse",
  "name": "Pulse",
  "niche": "DTC & apps",
  "description": "Rounded, current storefront for new brands and digital-native shops: indigo accent, pill CTAs, card canvas, dark footer.",
  "version": "1.2.0",
  "author": "Store Builder Platform",
  "preview": "/themes/pulse/preview.png",
  "features": {
    "rtl": true,
    "darkMode": false,
    "paid": false
  },
  "tokens": {
    "primaryColor": "#0f172a",
    "primaryTextColor": "#ffffff",
    "accentColor": "#4f46e5",
    "bodyBg": "#f8fafc",
    "cardBg": "#ffffff",
    "bodyText": "#0f172a",
    "mutedText": "#64748b",
    "borderColor": "#e2e8f0",
    "headerBg": "#ffffff",
    "headerText": "#0f172a",
    "footerBg": "#0f172a",
    "footerText": "#e2e8f0",
    "priceColor": "#0f172a",
    "saleColor": "#dc2626",
    "fontFamily": "system",
    "baseFontSize": 16,
    "headingWeight": 700,
    "radius": 16,
    "buttonRadius": 999,
    "containerWidth": 1280,
    "cardShadow": "soft",
    "productsPerRow": 3,
    "showTrustBar": true,
    "showTestimonials": true,
    "showStats": true,
    "showNewsletter": true,
    "showDealCountdown": true,
    "showCategories": true,
    "showFeatured": true,
    "showNewArrivals": true,
    "announcementBg": "#4f46e5",
    "announcementText2": "#ffffff"
  },
  "sections": {
    "hero": "@/themes/pulse/sections/Hero",
    "featured": "@/themes/pulse/sections/Featured",
    "categories": "@/themes/pulse/sections/Categories"
  },
  "layouts": {
    "home": {
      "columns": 12,
      "gap": 28,
      "blocks": [
        { "id": "hero", "type": "hero", "colStart": 1, "colSpan": 12, "rowStart": 1, "rowSpan": 1, "config": {} },
        { "id": "trust", "type": "trustBar", "colStart": 1, "colSpan": 12, "rowStart": 2, "rowSpan": 1, "config": {} },
        { "id": "feat", "type": "featured", "colStart": 1, "colSpan": 12, "rowStart": 3, "rowSpan": 1, "config": {} },
        { "id": "cats", "type": "categories", "colStart": 1, "colSpan": 12, "rowStart": 4, "rowSpan": 1, "config": {} },
        { "id": "new", "type": "newArrivals", "colStart": 1, "colSpan": 12, "rowStart": 5, "rowSpan": 1, "config": {} },
        { "id": "deal", "type": "dealCountdown", "colStart": 1, "colSpan": 12, "rowStart": 6, "rowSpan": 1, "config": {} },
        { "id": "quotes", "type": "testimonials", "colStart": 1, "colSpan": 12, "rowStart": 7, "rowSpan": 1, "config": {} },
        { "id": "news", "type": "newsletter", "colStart": 1, "colSpan": 12, "rowStart": 8, "rowSpan": 1, "config": {} }
      ]
    }
  }
}
