{
  "key": "minimal",
  "name": "Minimal",
  "niche": "Craft & editorial",
  "description": "Text-first atelier for writers, makers, and craft sellers. Narrow serif column, no marketing chrome — products and copy do the work.",
  "version": "1.3.1",
  "author": "Platform Team",
  "preview": "/themes/minimal/preview.png",
  "features": {
    "rtl": true,
    "darkMode": false,
    "paid": false
  },
  "tokens": {
    "primaryColor": "#1a1a1a",
    "primaryTextColor": "#fafaf7",
    "accentColor": "#8b6f47",
    "bodyBg": "#fafaf7",
    "cardBg": "#fafaf7",
    "bodyText": "#1a1a1a",
    "mutedText": "#6b6b65",
    "borderColor": "#e8e6e0",
    "headerBg": "#fafaf7",
    "headerText": "#1a1a1a",
    "footerBg": "#1a1a1a",
    "footerText": "#fafaf7",
    "priceColor": "#1a1a1a",
    "saleColor": "#8b3a3a",
    "fontFamily": "georgia",
    "baseFontSize": 17,
    "headingWeight": 600,
    "radius": 2,
    "buttonRadius": 0,
    "containerWidth": 960,
    "cardShadow": "none",
    "productsPerRow": 3,
    "showTrustBar": false,
    "showTestimonials": false,
    "showStats": false,
    "showNewsletter": true,
    "showDealCountdown": false,
    "showCategories": true,
    "showFeatured": true,
    "showNewArrivals": false,
    "announcementBg": "#1a1a1a",
    "announcementText2": "#fafaf7"
  },
  "sections": {
    "hero": "@/themes/minimal/sections/Hero",
    "featured": "@/themes/minimal/sections/Featured",
    "categories": "@/themes/minimal/sections/Categories"
  },
  "layouts": {
    "home": {
      "columns": 12,
      "gap": 32,
      "blocks": [
        {
          "id": "hero",
          "type": "hero",
          "colStart": 1,
          "colSpan": 12,
          "rowStart": 1,
          "rowSpan": 1,
          "config": {
            "hero": {
              "layout": "static",
              "height": "standard",
              "autoPlay": false
            }
          }
        },
        {
          "id": "featured",
          "type": "featured",
          "colStart": 1,
          "colSpan": 12,
          "rowStart": 2,
          "rowSpan": 1,
          "config": {
            "title": "Selected",
            "subtitle": "A short list.",
            "limit": 4
          }
        },
        {
          "id": "categories",
          "type": "categories",
          "colStart": 1,
          "colSpan": 12,
          "rowStart": 3,
          "rowSpan": 1,
          "config": {
            "title": "Index",
            "subtitle": "",
            "limit": 8
          }
        },
        {
          "id": "newsletter",
          "type": "newsletter",
          "colStart": 1,
          "colSpan": 12,
          "rowStart": 4,
          "rowSpan": 1,
          "config": {
            "title": "Notes",
            "subtitle": "Occasional letters, never a blast."
          }
        }
      ]
    }
  }
}
