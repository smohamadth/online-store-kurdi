{
  "key": "default",
  "name": "Default",
  "niche": "General retail",
  "description": "Conversion-first general storefront: four-column grid, trust bar, deals, and stats. Best for mixed catalogues and everyday shops.",
  "version": "1.2.0",
  "author": "Platform Team",
  "preview": "/themes/default/preview.png",
  "features": {
    "rtl": true,
    "darkMode": false,
    "paid": false
  },
  "tokens": {
    "primaryColor": "#111111",
    "primaryTextColor": "#ffffff",
    "accentColor": "#2563eb",
    "bodyBg": "#ffffff",
    "cardBg": "#ffffff",
    "bodyText": "#111111",
    "mutedText": "#6b7280",
    "borderColor": "#e5e7eb",
    "headerBg": "#ffffff",
    "headerText": "#111111",
    "footerBg": "#f9fafb",
    "footerText": "#111111",
    "priceColor": "#111111",
    "saleColor": "#dc2626",
    "fontFamily": "vazirmatn",
    "baseFontSize": 16,
    "headingWeight": 800,
    "radius": 8,
    "buttonRadius": 8,
    "containerWidth": 1200,
    "cardShadow": "soft",
    "productsPerRow": 4,
    "showTrustBar": true,
    "showTestimonials": true,
    "showStats": true,
    "showNewsletter": true,
    "showDealCountdown": true,
    "showCategories": true,
    "showFeatured": true,
    "showNewArrivals": true,
    "announcementBg": "#111111",
    "announcementText2": "#ffffff"
  },
  "sections": {
    "hero": "@/themes/default/sections/Hero",
    "featured": "@/themes/default/sections/Featured",
    "categories": "@/themes/default/sections/Categories"
  },
  "layouts": {
    "home": {
      "columns": 12,
      "gap": 24,
      "blocks": [
        { "id": "hero", "type": "hero", "colStart": 1, "colSpan": 12, "rowStart": 1, "rowSpan": 1, "config": {} },
        { "id": "trust", "type": "trustBar", "colStart": 1, "colSpan": 12, "rowStart": 2, "rowSpan": 1, "config": {} },
        { "id": "cats", "type": "categories", "colStart": 1, "colSpan": 12, "rowStart": 3, "rowSpan": 1, "config": {} },
        { "id": "feat", "type": "featured", "colStart": 1, "colSpan": 12, "rowStart": 4, "rowSpan": 1, "config": {} },
        { "id": "new", "type": "newArrivals", "colStart": 1, "colSpan": 12, "rowStart": 5, "rowSpan": 1, "config": {} },
        { "id": "deal", "type": "dealCountdown", "colStart": 1, "colSpan": 12, "rowStart": 6, "rowSpan": 1, "config": {} },
        { "id": "stats", "type": "stats", "colStart": 1, "colSpan": 12, "rowStart": 7, "rowSpan": 1, "config": {} },
        { "id": "quotes", "type": "testimonials", "colStart": 1, "colSpan": 12, "rowStart": 8, "rowSpan": 1, "config": {} },
        { "id": "news", "type": "newsletter", "colStart": 1, "colSpan": 12, "rowStart": 9, "rowSpan": 1, "config": {} }
      ]
    }
  }
}
