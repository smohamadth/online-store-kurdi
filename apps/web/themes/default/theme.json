{
  "key": "default",
  "name": "Default",
  "niche": "General retail",
  "description": "Conversion-first general storefront: four-column grid, trust bar, deals, and stats. Best for mixed catalogues and everyday shops.",
  "version": "1.3.1",
  "author": "Platform Team",
  "preview": "/themes/default/preview.png",
  "features": {
    "rtl": true,
    "darkMode": false,
    "paid": false
  },
  "tokens": {
    "primaryColor": "#111111",
    "primaryTextColor": "#ffffff",
    "accentColor": "#2563eb",
    "bodyBg": "#ffffff",
    "cardBg": "#ffffff",
    "bodyText": "#111111",
    "mutedText": "#6b7280",
    "borderColor": "#e5e7eb",
    "headerBg": "#ffffff",
    "headerText": "#111111",
    "footerBg": "#f9fafb",
    "footerText": "#111111",
    "priceColor": "#111111",
    "saleColor": "#dc2626",
    "fontFamily": "vazirmatn",
    "baseFontSize": 16,
    "headingWeight": 800,
    "radius": 8,
    "buttonRadius": 8,
    "containerWidth": 1200,
    "cardShadow": "soft",
    "productsPerRow": 4,
    "showTrustBar": true,
    "showTestimonials": true,
    "showStats": true,
    "showNewsletter": true,
    "showDealCountdown": true,
    "showCategories": true,
    "showFeatured": true,
    "showNewArrivals": true,
    "announcementBg": "#111111",
    "announcementText2": "#ffffff"
  },
  "sections": {
    "hero": "@/themes/default/sections/Hero",
    "featured": "@/themes/default/sections/Featured",
    "categories": "@/themes/default/sections/Categories"
  },
  "layouts": {
    "home": {
      "columns": 12,
      "gap": 24,
      "blocks": [
        { "id": "hero", "type": "hero", "colStart": 1, "colSpan": 12, "rowStart": 1, "rowSpan": 1, "config": { "hero": { "layout": "slideshow", "height": "standard", "autoPlay": true, "intervalSec": 6, "arrows": true, "dots": true } } },
        { "id": "promo", "type": "promo", "colStart": 1, "colSpan": 12, "rowStart": 2, "rowSpan": 1, "config": {} },
        { "id": "trustBar", "type": "trustBar", "colStart": 1, "colSpan": 12, "rowStart": 3, "rowSpan": 1, "config": { "items": [
          { "icon": "🚚", "title": "Free shipping", "text": "On orders over 50" },
          { "icon": "↩️", "title": "30-day returns", "text": "Hassle-free refunds" },
          { "icon": "🔒", "title": "Secure checkout", "text": "Encrypted payments" },
          { "icon": "💬", "title": "24/7 support", "text": "We reply within hours" }
        ] } },
        { "id": "categories", "type": "categories", "colStart": 1, "colSpan": 12, "rowStart": 4, "rowSpan": 1, "config": { "title": "Shop by Category", "subtitle": "Browse our wide selection of products", "limit": 8 } },
        { "id": "featured", "type": "featured", "colStart": 1, "colSpan": 12, "rowStart": 5, "rowSpan": 1, "config": { "title": "Featured Products", "subtitle": "Our most popular items", "limit": 8 } },
        { "id": "newArrivals", "type": "newArrivals", "colStart": 1, "colSpan": 12, "rowStart": 6, "rowSpan": 1, "config": { "title": "New Arrivals" } },
        { "id": "dealCountdown", "type": "dealCountdown", "colStart": 1, "colSpan": 12, "rowStart": 7, "rowSpan": 1, "config": { "title": "Save big before midnight", "subtitle": "Limited quantities on selected items. New deals drop every morning.", "badge": "Deal of the day", "buttonText": "Shop deals", "buttonHref": "/deals" } },
        { "id": "bannerStrip", "type": "bannerStrip", "colStart": 1, "colSpan": 12, "rowStart": 8, "rowSpan": 1, "config": {} },
        { "id": "trending", "type": "trending", "colStart": 1, "colSpan": 12, "rowStart": 9, "rowSpan": 1, "config": { "title": "Trending Now" } },
        { "id": "testimonials", "type": "testimonials", "colStart": 1, "colSpan": 12, "rowStart": 10, "rowSpan": 1, "config": { "title": "Loved by our customers", "items": [
          { "name": "Sarah M.", "role": "Verified buyer", "rating": 5, "text": "Ordered on a Monday and it arrived Wednesday." },
          { "name": "Daniel K.", "role": "Verified buyer", "rating": 5, "text": "Support answered within the hour." },
          { "name": "Ava R.", "role": "Verified buyer", "rating": 4, "text": "Great prices. This is my third order this year." }
        ] } },
        { "id": "gallery", "type": "gallery", "colStart": 1, "colSpan": 12, "rowStart": 11, "rowSpan": 1, "config": { "title": "From our shop", "layout": "masonry", "columns": 4 } },
        { "id": "stats", "type": "stats", "colStart": 1, "colSpan": 12, "rowStart": 12, "rowSpan": 1, "config": { "items": [
          { "value": "12500", "suffix": "+", "label": "Happy customers" },
          { "value": "48000", "suffix": "+", "label": "Orders delivered" },
          { "value": "4.9", "suffix": "/5", "label": "Average rating" },
          { "value": "32", "suffix": "", "label": "Countries served" }
        ] } },
        { "id": "features", "type": "features", "colStart": 1, "colSpan": 12, "rowStart": 13, "rowSpan": 1, "config": { "items": [
          { "icon": "🚚", "title": "Free Shipping", "text": "On orders over $100" },
          { "icon": "🔒", "title": "Secure Payment", "text": "100% secure checkout" },
          { "icon": "🌍", "title": "Worldwide Shipping", "text": "Deliver to your door" },
          { "icon": "🔄", "title": "Easy Returns", "text": "30 day return policy" }
        ] } },
        { "id": "cta", "type": "cta", "colStart": 1, "colSpan": 12, "rowStart": 14, "rowSpan": 1, "config": { "title": "Ready to shop?", "subtitle": "The full catalogue — new drops every week.", "buttonText": "Shop now", "buttonHref": "/products" } },
        { "id": "newsletter", "type": "newsletter", "colStart": 1, "colSpan": 12, "rowStart": 15, "rowSpan": 1, "config": { "title": "Subscribe to Our Newsletter" } }
      ]
    }
  }
}
